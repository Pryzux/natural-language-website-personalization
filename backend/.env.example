# LLM Configuration (REQUIRED)
# LLM_MODEL: "OpenAI" or "Anthropic"
# LLM_VERSION: Model version
#   OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
#   Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
LLM_MODEL=OpenAI
LLM_VERSION=gpt-4o

# API Key (for whichever provider you're using)
LLM_API_KEY=your_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:3000

# Debug/Development Settings
# Save all requests to /backend/requests/ for debugging (default: false)
SAVE_REQUESTS=false

# Maximum HTML length from extension to send to LLM (in characters)
# Set to a number to truncate HTML received from extension || None = No Truncation
MAX_HTML_LENGTH_FROM_EXTENSION=None

# System Prompt Configuration
# Edit /backend/transform/llm/system_prompt.txt to customize the LLM instructions


